# KORA — production environment template.
# Copy to .env.local (local dev) or paste into Hostinger's Node.js
# Environment Variables panel. NAMES ONLY — never commit real secrets.
# EVERY variable the code reads is listed here (see FINAL REPORT §6).

# --- App ---
# Public site origin (emails, links, OAuth callbacks). No trailing slash.
NEXT_PUBLIC_SITE_URL=https://your-domain.com
# Long random secret for session JWTs. REQUIRED — generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# NODE_ENV is set by the platform (production on Hostinger).
# One-time production seeding: set ALLOW_SEED=true, POST /api/admin/seed
# once as admin, then REMOVE it. Never leave it enabled.
# ALLOW_SEED=true

# --- Database (PostgreSQL, REQUIRED) ---
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# --- Paystack (REQUIRED for card/MoMo checkout) ---
# TEST MODE first: sk_test_... / pk_test_... — never mix test and live keys.
# LIVE MODE: sk_live_... / pk_live_...
PAYSTACK_SECRET_KEY=
# Public key is safe to expose to the browser (used by the Paystack popup).
# Either name works; NEXT_PUBLIC_ variant is preferred on Hostinger.
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
# or: PAYSTACK_PUBLIC_KEY=
#
# Webhook URL to register in the Paystack dashboard (must be publicly reachable):
#   https://YOUR-DOMAIN/api/payments/paystack/webhook
# Enable events: charge.success, charge.failed, transfer.success,
# transfer.failed, transfer.reversed. The secret key signs webhook payloads —
# no separate webhook secret is needed.
#
# --- Automated tests only (NEVER set in production) ---
# PAYSTACK_SIMULATE=true  → bypass Paystack with explicit simulated results
# PAYSTACK_API_URL=http://127.0.0.1:4100 → point the client at the mock server

# --- Firebase Google sign-in (OPTIONAL) ---
# Without these, the app runs on email/password auth only and the Google
# button is hidden. With them, "Continue with Google" appears on login/register
# and POST /api/auth/firebase exchanges ID tokens for app sessions.
# Values come from the Firebase console → Project settings → Your apps → Web.
# These keys are public-by-design (Firebase secures access via Security Rules
# + our backend ID-token verification); the session JWT stays server-side.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Server-side alternative to NEXT_PUBLIC_FIREBASE_PROJECT_ID (rarely needed):
# FIREBASE_PROJECT_ID=
# Force cryptographic ID-token verification even outside production:
# FIREBASE_REQUIRE_SIGNATURE=true

# --- Outgoing email (OPTIONAL — notifications stay in-app without it) ---
# EMAIL_PROVIDER=resend → needs RESEND_API_KEY + EMAIL_FROM
# EMAIL_PROVIDER=smtp    → needs SMTP_HOST/PORT/USER/PASS + EMAIL_FROM
# Unset/unknown provider → email sending disabled, in-app inbox still works.
EMAIL_PROVIDER=
EMAIL_FROM=KORA <noreply@example.com>
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
