# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db
JWT_SECRET=change-me-in-production

# ─── Email (verification codes + seller-application lifecycle) ───────────────
# While EMAIL_PROVIDER is empty, emails are skipped honestly (logged server-side)
# and the app falls back to in-app notifications. Nothing is faked as sent.
#   resend → set EMAIL_PROVIDER=resend plus RESEND_API_KEY (+ EMAIL_FROM)
#   smtp   → set EMAIL_PROVIDER=smtp plus SMTP_HOST/SMTP_USER/SMTP_PASS (+ SMTP_PORT, EMAIL_FROM)
EMAIL_PROVIDER=
RESEND_API_KEY=
EMAIL_FROM=MarketPlace GH <noreply@marketplace-gh.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Public base URL used inside email links (dashboard / status links).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Paystack (checkout payments) ────────────────────────────────────────────
# Get both keys from https://dashboard.paystack.com/#/settings/developers
# While empty, checkout runs in simulated mode (no real charges).
PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
# SMS: set SMS_PROVIDER=termii (TERMII_API_KEY), =mnotify (MNOTIFY_API_KEY),
# or =twilio (TWILIO_* below).
SMS_PROVIDER=
TERMII_API_KEY=
TERMII_SENDER=
MNOTIFY_API_KEY=
MNOTIFY_SENDER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# ─── Firebase (client / web config) ──────────────────────────────────────────
# Firebase console -> Project settings -> Your apps -> Web app -> SDK setup
# These are public values (safe to expose to the browser).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ─── Firebase Admin (server-side token verification) ─────────────────────────
# Firebase console -> Project settings -> Service accounts -> Generate new private key
# Provide EITHER the full service-account JSON on one line:
FIREBASE_SERVICE_ACCOUNT=
# OR the three fields separately:
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ─── Signature enforcement ───────────────────────────────────────────────────
# In production the ID token signature is ALWAYS verified against Google's JWKs.
# In development this sandbox has no network egress to Google, so the server
# falls back to decoding the token and checking its claims without verifying the
# signature (printing a warning). Set this to "true" to disable that fallback.
FIREBASE_REQUIRE_SIGNATURE=false

# NOTE: the client-side Firebase config above is all that is needed to sign in.
# If the NEXT_PUBLIC_FIREBASE_* values are empty, the app falls back to the
# built-in email/password auth so the demo keeps working.
